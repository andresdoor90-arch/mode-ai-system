# M-A-S (Mode AI System) - Environment Variables Example
# Copy this file to `.env` (and optionally `.env.local`) and fill in your values.
# `.env` and `.env.local` are gitignored; only `.env.example` is committed.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Mode AI System
APP_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Embedded backend (Fastify) - used in later phases
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=4317

# ---------------------------------------------------------------------------
# Local AI (Ollama) - used in later phases
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Cloud AI providers (optional) - used in later phases
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Storage / Database - used in later phases
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/mas.sqlite
CHROMA_PATH=./data/chroma
STORAGE_ROOT=./data/storage
