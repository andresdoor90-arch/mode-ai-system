auto-install-peers=true
strict-peer-dependencies=false
# Hoisted layout (flat node_modules, npm-like) so native modules and their
# install helpers (e.g. better-sqlite3 + prebuild-install) resolve correctly
# during electron-builder's rebuild step on all platforms — isolated/symlinked
# layouts break the native rebuild on the Windows runner.
shamefully-hoist=true
node-linker=hoisted
prefer-workspace-packages=true
save-exact=false
engine-strict=true
