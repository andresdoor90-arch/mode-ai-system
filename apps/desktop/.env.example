# M-A-S Desktop App - Environment Variables Example
# Copy to `.env` / `.env.local` (both gitignored). Only this example is committed.
# Renderer-exposed variables MUST be prefixed with VITE_ (Vite convention).

# Renderer (exposed to the browser context)
VITE_APP_TITLE=Mode AI System

# Main process (Node context) - used in later phases
SERVER_HOST=127.0.0.1
SERVER_PORT=4317
