{
  "name": "@mas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "M-A-S desktop application (Electron main process, preload bridge, React renderer, embedded Fastify backend).",
  "license": "UNLICENSED",
  "author": "M-A-S",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mas/core": "workspace:*",
    "@mas/infrastructure": "workspace:*",
    "@mas/plugin-sdk": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-vite": "^2.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
