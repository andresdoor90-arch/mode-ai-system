{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out",
    "tsBuildInfoFile": "./out/.tsbuildinfo-web",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@mas/core": ["../../packages/core/src/index.ts"],
      "@mas/core/*": ["../../packages/core/src/*"],
      "@mas/infrastructure": ["../../packages/infrastructure/src/index.ts"],
      "@mas/infrastructure/*": ["../../packages/infrastructure/src/*"],
      "@mas/rendering": ["../../packages/rendering/src/index.ts"],
      "@mas/rendering/*": ["../../packages/rendering/src/*"],
      "@mas/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@mas/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    }
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/infrastructure" },
    { "path": "../../packages/rendering" },
    { "path": "../../packages/plugin-sdk" }
  ],
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
