{
  "name": "mode-ai-system",
  "version": "0.1.0",
  "private": true,
  "description": "M-A-S (Mode AI System) - AI-powered fashion and outfit recommendation desktop application",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.7.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @mas/desktop dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @mas/desktop build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dist": "pnpm build:packages && pnpm --filter @mas/desktop package",
    "dist:win": "pnpm build:packages && pnpm --filter @mas/desktop package:win",
    "dist:mac": "pnpm build:packages && pnpm --filter @mas/desktop package:mac",
    "dist:linux": "pnpm build:packages && pnpm --filter @mas/desktop package:linux",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx,.cts,.mts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "pnpm -r exec rimraf dist out node_modules/.cache coverage && rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@playwright/test": "^1.46.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.5",
    "jsdom": "^24.1.1",
    "lint-staged": "^15.2.9",
    "playwright": "^1.46.1",
    "prettier": "3.8.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
